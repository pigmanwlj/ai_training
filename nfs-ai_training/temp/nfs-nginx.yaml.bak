apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: nfs-nginx
  name: nfs-nginx
spec:
  replicas: 3
  selector:
    matchLabels:
      app: nfs-nginx
  template:
    metadata:
      labels:
        app: nfs-nginx
    spec:
      containers:
      - image: docker.saicmaxus.com/nginx
        name: nfs-nginx
        volumeMounts:    #定义数据持久化
          - name: nfs-pvc002
            mountPath: /usr/share/nginx/html
      volumes:
        - name: nfs-pvc002
          persistentVolumeClaim:   #指定pvc，注意下面声明的pvc指向的是上面定义的pvc名称
            claimName: test-claim002


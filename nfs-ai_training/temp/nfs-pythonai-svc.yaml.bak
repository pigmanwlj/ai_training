apiVersion: v1
kind: Service
metadata:
  name: nfs-pythonai-svc
  namespace: ai-training
spec:
  type: NodePort
  selector:
    app: nfs-pythonai
  ports:
  - name: nfs-pythonai
    port: 8000
    targetPort: 8000
    nodePort: 32068
  - name: nfs-pythonai-daphne
    port: 8001
    targetPort: 8001
    nodePort: 32069

